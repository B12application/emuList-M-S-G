# Cloudflare Pages Global Security and Caching Headers

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Immutable caching for hashed Vite assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Short / revalidate caching for static icons and maps
/titlelogo.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/logob12.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/turkey-map.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/world-map.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/sounds/*
  Cache-Control: public, max-age=2592000, immutable

# Always validate HTML and Service Worker for immediate update deployments
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
