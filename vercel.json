{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/.env(.*)",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/.git(.*)",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/(.*).php(.*)",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/phpinfo(.*)",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/wp-(.*)",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/tmp/(.*)",
      "destination": "/404.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/gold-price",
      "destination": "https://finans.truncgil.com/today.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
